{
  "manifest_version": 3,
  "name": "DeepSeek 侧栏助手",
  "description": "选中文字后，在 Chrome 右侧栏直接使用 DeepSeek 提问。",
    "version": "0.8.3",
  "icons": { "16": "icons/whale-16.png", "32": "icons/whale-32.png", "48": "icons/whale-48.png", "128": "icons/whale-128.png" },
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "sidePanel",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*",
    "file:///*"
  ],
  "content_scripts": [{
    "matches": ["https://*/*", "http://*/*"],
    "js": ["selection-guard.js", "content.js"],
    "run_at": "document_idle"
  }],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 DeepSeek 侧栏",
    "default_icon": { "16": "icons/whale-16.png", "32": "icons/whale-32.png", "48": "icons/whale-48.png", "128": "icons/whale-128.png" }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "open-deepseek-sidebar": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "把当前选中文字送到 DeepSeek 侧栏"
    }
  }
}
